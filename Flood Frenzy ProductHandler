local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local LavaModule = require(ReplicatedStorage.Modules.LavaHandler)
local PlayerData = require(ServerScriptService.PlayerData.Manager)

local CONFIG = {
	MIN_PLAYERS = 2,
	START_COUNTDOWN = 8,
	ROUND_TIMEOUT = 110,
	LAVA_HEIGHT = 160,
	INTERMISSION = 20,
	REVIVE_WINDOW = 15,
	REVIVE_IMMUNITY = 8,
	WIN_COINS = 100,
	REVIVE_PRODUCT_ID = 3416412836,
}

local lobby = Workspace:WaitForChild("Lobby")
local GearsFolder = ReplicatedStorage:FindFirstChild("Gears")

local ProductPurchasedEvent: BindableEvent = ReplicatedStorage:WaitForChild("ProductPurchased")
local RoundEndedEvent = Instance.new("BindableEvent")
local RoundStateChanged = ReplicatedStorage.Remotes:FindFirstChild("RoundStateChanged")

local HeightBarSet = ReplicatedStorage.Remotes:WaitForChild("HeightBar_Set")
local HeightBarHide = ReplicatedStorage.Remotes:WaitForChild("HeightBar_Hide")
local SoundPlayRemote = ReplicatedStorage.Remotes:WaitForChild("SoundPlay")

local roundActive = false
local currentTopY, currentBottomY = nil, nil
local roundEnded = false
local winner = nil
local reviveCredits = {}
local RoundPlayers = {}

ProductPurchasedEvent.Event:Connect(function(prod, plr)
	if prod == CONFIG.REVIVE_PRODUCT_ID then
		reviveCredits[plr] = (reviveCredits[plr] or 0) + 1
	end
end)

Players.PlayerAdded:Connect(function(plr)
	if roundActive and currentTopY and currentBottomY then
		HeightBarSet:FireClient(plr, currentTopY, currentBottomY)
	end
end)

Players.PlayerRemoving:Connect(function(plr)
	reviveCredits[plr] = nil
end)

local function safeFireClient(remote, player, ...)
	local args = table.pack(...)
	pcall(function()
		remote:FireClient(player, table.unpack(args, 1, args.n))
	end)
end

local function playLobbyMusic()
	for _, player in ipairs(Players:GetPlayers()) do
		safeFireClient(SoundPlayRemote, player, {
			action = "stop",
			name = "GameAudio",
			fadeDuration = 3,
		})
		safeFireClient(SoundPlayRemote, player, {
			action = "play",
			sound = "LobbySoundtrack",
			name = "LobbySoundtrack",
			fadein = true,
			targetVolume = 0.5,
		})
	end
end

local function clearTools(player)
	if player.Backpack then
		for _, tool in ipairs(player.Backpack:GetChildren()) do
			if tool:IsA("Tool") then tool:Destroy() end
		end
	end
	if player.Character then
		for _, tool in ipairs(player.Character:GetChildren()) do
			if tool:IsA("Tool") then tool:Destroy() end
		end
	end
end

local function equipPlayerGears(player)
	local EquippedItem = player:FindFirstChild("EquippedItem")
	if EquippedItem and GearsFolder then
		local gearTemplate = GearsFolder:FindFirstChild(EquippedItem.Value)
		if gearTemplate then
			local BoughtItem = gearTemplate:Clone()
			BoughtItem.Parent = player:WaitForChild("Backpack")
		end
	end

	local gpFolder = player:FindFirstChild("GamePassItems")
	local gpGears = ReplicatedStorage:FindFirstChild("GamepassGears")
	if gpFolder and gpGears then
		for _, gearVal in ipairs(gpFolder:GetChildren()) do
			local template = gpGears:FindFirstChild(gearVal.Name)
			if template then
				local BoughtItem = template:Clone()
				BoughtItem.Parent = player:WaitForChild("Backpack")
			end
		end
	end
end

local function runRound()
	roundEnded = false
	winner = nil
	table.clear(RoundPlayers)
	LavaModule.UpdateUI_Players("Round is starting soon...")

	while #Players:GetPlayers() < CONFIG.MIN_PLAYERS do
		local count = #Players:GetPlayers()
		LavaModule.UpdateUI_Players("Waiting for players... ("..count.."/"..CONFIG.MIN_PLAYERS..")")
		task.wait(2)
	end

	LavaModule.UpdateUI_Players("Go to the shop and buy gears!")

	if Workspace:FindFirstChild("Map") then Workspace.Map:Destroy() end

	local newMap = LavaModule.SpawnRandomMap()
	if not newMap then
		warn("No maps available!")
		LavaModule.UpdateUI_timer("No maps available, retrying...")
		task.wait(5)
		return
	end

	local heightPart = newMap:FindFirstChild("HeightBar")
	if heightPart and heightPart:IsA("BasePart") then
		currentTopY = heightPart.Position.Y + heightPart.Size.Y / 2
		currentBottomY = heightPart.Position.Y - heightPart.Size.Y / 2
	else
		currentTopY, currentBottomY = 50, 0
	end

	local lobbySpawn = lobby:FindFirstChild("SpawnLocation")
	local specialParts = newMap:WaitForChild("SpecialParts")
	local targetPart = specialParts:WaitForChild("Ceiling")
	local winPart = specialParts:WaitForChild("WinButton")

	for i = CONFIG.START_COUNTDOWN, 1, -1 do
		LavaModule.UpdateUI_timer("Round starts in "..i.."...")
		task.wait(1)
	end

	roundActive = true
	RoundStateChanged:FireAllClients(true)
	HeightBarSet:FireAllClients(currentTopY, currentBottomY)

	local spawnParts = newMap:FindFirstChild("Spawns") and newMap.Spawns:FindFirstChild("SPAWN")
	for _, player in ipairs(Players:GetPlayers()) do
		table.insert(RoundPlayers, player)
		if spawnParts then LavaModule.TeleportPlayerTo(player, spawnParts) end
		equipPlayerGears(player)
	end

	local alivePlayers = {}
	local diedConnections = {}
	local connections = {}

	local function spawnPlr(splr, respawnPos)
		local existCon = diedConnections[splr]
		if existCon then existCon:Disconnect() end

		local character = splr.Character or splr.CharacterAdded:Wait()
		local humanoid = character:FindFirstChild("Humanoid")
		if not humanoid then return end

		if respawnPos then
			LavaModule.TeleportPlayerTo(splr, CFrame.new(respawnPos), true)
		end
		alivePlayers[splr] = true

		diedConnections[splr] = humanoid.Died:Connect(function()
			alivePlayers[splr] = nil
			local aliveCount, lastAlivePlayer = 0, nil
			for p, _ in pairs(alivePlayers) do
				aliveCount += 1
				lastAlivePlayer = p
			end

			if aliveCount <= 1 and not roundEnded then
				roundEnded = true
				winner = (aliveCount == 1) and lastAlivePlayer or nil
				RoundEndedEvent:Fire()
				return
			end

			task.spawn(function()
				local lastPos
				local hrp = character:FindFirstChild("HumanoidRootPart")
				if hrp then lastPos = hrp.Position end

				local start = tick()
				while tick() - start <= CONFIG.REVIVE_WINDOW do
					if roundEnded then return end
					if reviveCredits[splr] and reviveCredits[splr] >= 1 and lastPos then
						reviveCredits[splr] -= 1
						splr:SetAttribute("Immune", tick() + CONFIG.REVIVE_IMMUNITY)
						spawnPlr(splr, lastPos)
						return
					end
					task.wait(1)
				end
			end)
		end)
	end

	local leftConn = Players.PlayerRemoving:Connect(function(plr)
		if alivePlayers[plr] then
			alivePlayers[plr] = nil
			local aliveCount, lastAlivePlayer = 0, nil
			for p, _ in pairs(alivePlayers) do
				aliveCount += 1
				lastAlivePlayer = p
			end
			if aliveCount <= 1 and not roundEnded then
				roundEnded = true
				winner = (aliveCount == 1) and lastAlivePlayer or nil
				RoundEndedEvent:Fire()
			end
		end
	end)
	table.insert(connections, leftConn)

	for _, player in ipairs(RoundPlayers) do spawnPlr(player) end

	task.spawn(function()
		local startTime = tick()
		while tick() - startTime < CONFIG.ROUND_TIMEOUT do
			if roundEnded then return end
			task.wait(1)
		end
		if not roundEnded then
			roundEnded = true
			winner = nil
			pcall(function() ReplicatedStorage:SetAttribute("LavaRise", false) end)
			RoundEndedEvent:Fire()
		end
	end)

	if winPart then
		local touchConn = winPart.Touched:Connect(function(hit)
			local character = hit.Parent
			if not character then return end
			local player = Players:GetPlayerFromCharacter(character)
			local humanoid = character:FindFirstChild("Humanoid")
			if player and humanoid and humanoid.Health > 0 and not roundEnded then
				roundEnded = true
				winner = player
				RoundEndedEvent:Fire()
			end
		end)
		table.insert(connections, touchConn)
	end

	pcall(function() ReplicatedStorage:SetAttribute("LavaRise", true) end)

	task.spawn(function()
		LavaModule.StartGrowing(targetPart, CONFIG.LAVA_HEIGHT)
		if not roundEnded then
			roundEnded = true
			RoundEndedEvent:Fire()
		end
	end)

	RoundEndedEvent.Event:Wait()

	roundActive = false
	RoundStateChanged:FireAllClients(false)
	currentTopY, currentBottomY = nil, nil
	HeightBarHide:FireAllClients()

	pcall(function() ReplicatedStorage:SetAttribute("LavaRise", false) end)
	pcall(function() LavaModule.ClearRoundState() end)

	if Workspace:FindFirstChild("lava") then
		pcall(function() Workspace.lava:Destroy() end)
	end

	for splr, conn in pairs(diedConnections) do
		if conn then pcall(function() conn:Disconnect() end) end
		diedConnections[splr] = nil
	end
	for _, conn in ipairs(connections) do
		if conn then pcall(function() conn:Disconnect() end) end
	end
	for k in pairs(alivePlayers) do alivePlayers[k] = nil end

	if winner and winner.Parent then
		playLobbyMusic()
		LavaModule.UpdateUI_timer(winner.Name.." WON!")
		ReplicatedStorage.Remotes.WinnerUI:FireAllClients(winner.Name, CONFIG.WIN_COINS)
		PlayerData.AdjustCoins(winner, CONFIG.WIN_COINS)
		PlayerData.AdjustWins(winner, 1)
	else
		LavaModule.UpdateUI_timer("No winner this round!")
		ReplicatedStorage.Remotes.WinnerUI:FireAllClients("", 0)
	end

	task.wait(5)
	ReplicatedStorage.Remotes.WinnerUI:FireAllClients("__HIDE__", 0)

	for _, player in ipairs(Players:GetPlayers()) do
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum.Health = hum.MaxHealth end
	end

	LavaModule.TeleportAllTo(lobbySpawn)
	for _, player in ipairs(RoundPlayers) do
		if player.Parent then clearTools(player) end
	end

	if Workspace:FindFirstChild("lava") then Workspace.lava:Destroy() end

	LavaModule.UpdateUI_Players("Round is starting soon...")
	for i = CONFIG.INTERMISSION, 1, -1 do
		LavaModule.UpdateUI_timer("Intermission: "..i)
		task.wait(1)
	end
end

while true do
	local ok, err = pcall(runRound)
	if not ok then
		warn("Round errored:", err)
		roundActive = false
		pcall(function() RoundStateChanged:FireAllClients(false) end)
		pcall(function() HeightBarHide:FireAllClients() end)
		pcall(function() ReplicatedStorage:SetAttribute("LavaRise", false) end)
		task.wait(5)
	end
end
